parameters:
    level: 6
    bootstrapFiles:
        - vendor/autoload.php
        - tools/phpstan/includes/vendor/autoload.php
    paths:
        - src/Maker
        - tests/Command
        - tests/Docker
        - tests/Functional
        - tests/Harness
    excludePaths:
        - tests/Doctrine/fixtures
        - tests/fixtures
        - tests/Security/fixtures
        - tests/Security/yaml_fixtures
        - tests/tmp
        - tests/Util/fixtures
        - tests/Util/yaml_fixtures
    ignoreErrors:
        -
            message: '#Class Symfony\\Bundle\\MakerBundle\\Maker\\LegacyApiTestCase not found#'
            path: src/Maker/*

        -
            message: '#^Method .*Test\:\:test\w+\(.* has no return type specified\.$#'
            identifier: missingType.return
            path: tests/*

        # MakerTestCase supports both the outer simple-phpunit (PHPUnit 9.6)
        # and modern PHPUnit; which compat branch is "impossible" depends on
        # the PHPUnit version phpstan's includes resolve, so these may or may
        # not be reported, hence reportUnmatched: false
        -
            message: '#Call to function method_exists\(\) with \$this\(Symfony\\Bundle\\MakerBundle\\Tests\\Harness\\MakerTestCase\) and .(name|status). will always evaluate to true\.#'
            path: tests/Harness/MakerTestCase.php
            reportUnmatched: false
        -
            message: '#Call to an undefined method Symfony\\Bundle\\MakerBundle\\Tests\\Harness\\MakerTestCase\:\:(getName|getStatus)\(\)\.#'
            path: tests/Harness/MakerTestCase.php
            reportUnmatched: false
        -
            message: '#Access to constant STATUS_PASSED on an unknown class PHPUnit\\Runner\\BaseTestRunner\.#'
            path: tests/Harness/MakerTestCase.php
            reportUnmatched: false
