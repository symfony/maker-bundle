<?php

namespace App\Tests;

use App\Entity\{{ userShortName }};
use Doctrine\ORM\EntityManagerInterface;
use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
use Symfony\Component\PasswordHasher\Hasher\UserPasswordHasherInterface;

/*
 * Drives the complete generated reset-password cycle: request form, email,
 * token link, reset form, redirect. This is what proves the reset templates
 * and the ChangePasswordFormType really execute.
 */
class ResetPasswordFlowTest extends WebTestCase
{
    public function testFullResetCycle()
    {
        $client = static::createClient();

        /** @var EntityManagerInterface $em */
        $em = static::getContainer()->get('doctrine')->getManager();

        $user = (new {{ userShortName }}())->{{ emailSetter }}('{{ email }}');
        {% if hasPassword %}
        $user->setPassword('initial-password-hash');
        {% endif %}
        $em->persist($user);
        $em->flush();

        $client->request('GET', '/reset-password');
        self::assertResponseIsSuccessful();

        $client->submitForm('Send password reset email', [
            'reset_password_request_form[{{ emailField }}]' => '{{ email }}',
        ]);
        self::assertResponseRedirects('/reset-password/check-email');

        // capture the email before following the redirect: the client boots a
        // fresh kernel per request, which clears the collected mailer events
        self::assertEmailCount(1);
        preg_match('#(/reset-password/reset/[a-zA-Z0-9]+)#', self::getMailerMessage()->toString(), $resetLink);
        self::assertNotEmpty($resetLink[1] ?? '', 'No reset link found in the email.');

        $client->followRedirect();
        self::assertPageTitleSame('Password Reset Email Sent');

        $client->request('GET', $resetLink[1]);
        self::assertResponseRedirects('/reset-password/reset');
        $client->followRedirect();
        self::assertResponseIsSuccessful();

        $client->submitForm('Reset password', [
            'change_password_form[plainPassword][first]' => 'newStrongPassword',
            'change_password_form[plainPassword][second]' => 'newStrongPassword',
        ]);

        {% if hasPassword %}
        self::assertTrue($client->getResponse()->isRedirect());
        $client->followRedirect();
        self::assertResponseIsSuccessful();

        $user = $em->getRepository({{ userShortName }}::class)->findOneBy(['{{ emailField }}' => '{{ email }}']);
        self::assertTrue(
            static::getContainer()->get(UserPasswordHasherInterface::class)->isPasswordValid($user, 'newStrongPassword'),
        );
        {% else %}
        // current maker behavior: it generates a hashPassword() call even for a
        // user class without a password, which fails at runtime when executed
        self::assertSame(500, $client->getResponse()->getStatusCode());
        {% endif %}
    }
}
